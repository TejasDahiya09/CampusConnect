# Reference only: this file is not a shared runtime configuration.
# Copy the app-specific templates in frontend/, backend/ and ai-service/.

NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional direct, non-pooled URL for Prisma migrations on hosted PostgreSQL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
# AWS Marketplace media variables are backend-only and documented in backend/.env.example.
REDIS_URL=redis://localhost:6379
# Optional backend-only FastAPI AI service. Do not create a VITE_AI_SERVICE_URL.
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=1500
AI_LOST_FOUND_CANDIDATE_LIMIT=100
AI_LOST_FOUND_TOP_K=5
# Generate a stable backend-only Base64-encoded 32-byte key for message encryption.
MESSAGE_ENCRYPTION_KEY=
