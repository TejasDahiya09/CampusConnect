# AI-service configuration only. This service intentionally has no database,
# Supabase, AWS, or Google credential files. Vertex AI uses Application Default Credentials.
AI_SERVICE_NAME=CampusConnect AI Service
AI_SERVICE_VERSION=0.1.0
AI_SERVICE_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# Must equal the backend's AI_SERVICE_API_KEY. Use a strong deployment secret.
AI_SERVICE_API_KEY=replace-with-a-dedicated-internal-service-secret
AI_INFERENCE_CONCURRENCY=2
AI_MAX_REQUEST_BYTES=1500000
RESUME_MAX_BYTES=5242880
RESUME_MAX_TEXT_CHARACTERS=100000
RESUME_PROCESSING_TIMEOUT_SECONDS=10
# Campus Assistant generation. Disabled by default; accessed only through Express.
CAMPUS_ASSISTANT_ENABLED=false
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GENERATION_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_CONCURRENCY=1
AI_LOST_FOUND_MAX_CANDIDATES=100
AI_LOST_FOUND_MAX_TOP_K=20
AI_LOST_FOUND_WEIGHT_TEXT=0.55
AI_LOST_FOUND_WEIGHT_CATEGORY=0.20
AI_LOST_FOUND_WEIGHT_LOCATION=0.15
AI_LOST_FOUND_WEIGHT_TIME=0.10
AI_LOST_FOUND_TIME_DECAY_DAYS=14
AI_LOST_FOUND_HIGH_CONFIDENCE_THRESHOLD=0.70
AI_LOST_FOUND_MEDIUM_CONFIDENCE_THRESHOLD=0.40
AI_LOST_FOUND_MIN_SEMANTIC_SIMILARITY=0.50
AI_LOST_FOUND_MATCHER=semantic
AI_LOST_FOUND_IMAGE_CACHE_SIZE=256
AI_LOST_FOUND_IMAGE_DEVICE=cpu
AI_LOST_FOUND_EMBEDDING_CACHE_SIZE=512
AI_LOST_FOUND_EMBEDDING_DEVICE=cpu
