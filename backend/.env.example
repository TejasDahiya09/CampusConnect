NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional direct, non-pooled URL for Prisma migrations on hosted PostgreSQL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
AWS_REGION=your-aws-region
# Optional locally. Omit both variables when the runtime uses an IAM role.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-private-bucket-name
AWS_CLOUDFRONT_DOMAIN=cdn.example.com
REDIS_URL=redis://localhost:6379
# Optional independent FastAPI service. Core backend features continue when disabled.
AI_SERVICE_ENABLED=false
ADMIN_ALLOWED_USER_ID=00000000-0000-4000-8000-000000000000
AI_LOST_FOUND_MULTIMODAL_ENABLED=false
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=3000
# Must exceed FastAPI's Gemini generation timeout while remaining below the frontend timeout.
AI_SERVICE_GENERATION_TIMEOUT_MS=25000
AI_SERVICE_API_KEY=replace-with-the-same-dedicated-internal-service-secret
AI_LOST_FOUND_CANDIDATE_LIMIT=100
AI_LOST_FOUND_TOP_K=5
RESUME_MAX_BYTES=5242880
RESUME_ANALYSIS_TIMEOUT_MS=15000
MESSAGE_ENCRYPTION_KEY=
# Examiner demo seeding is opt-in and never runs during application startup.
DEMO_SEED_ENVIRONMENT=demo
DEMO_SEED_APPROVED_DATABASE_HOST=your-approved-database-host
DEMO_USER_IDS=00000000-0000-4000-a000-000000000001,00000000-0000-4000-a000-000000000002,00000000-0000-4000-a000-000000000003
DEMO_MEDIA_APPROVED_S3_BUCKET=your-approved-private-bucket-name
DEMO_MEDIA_APPROVED_CLOUDFRONT_DOMAIN=your-approved-cloudfront-domain.cloudfront.net

# Enable only after separate approval/application of the native professional-details migration.
PROFILE_PROFESSIONAL_STORAGE_READY=false

# Local-only profile photos: approve infrastructure and the designated development account first.
PROFILE_PHOTO_STORAGE_READY=false
# Dedicated random server-only secret (at least 32 characters), never a VITE variable.
PROFILE_PHOTO_UPLOAD_SECRET=

# Verified ACTIVE development student UUID; other accounts cannot use local photo storage.
PROFILE_PHOTO_LOCAL_OWNER_ID=
